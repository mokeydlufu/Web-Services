node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven
target/
*.class
.mvn/wrapper/maven-wrapper.jar

# IDEs and Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.springBeans
.sts4-cache
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Environment variables
.env
.env.local
.env.*.local

# Scratch / Temporary SQL scripts
scratch_*.sql

# JVM Crash Dumps
hs_err_pid*.log
replay_pid*.log
