# =================================================================
# VARIABLES DE ENTORNO - PLATAFORMA DE EMPLEABILIDAD ESTUDIANTIL
# Copia este archivo como .env para personalizar configuraciones
# =================================================================

# ----------------- BASE DE DATOS (PostgreSQL) -----------------
DB_URL=jdbc:postgresql://localhost:5432/db_empleabilidad
DB_USERNAME=postgres
DB_PASSWORD=root

# ----------------- SEGURIDAD & AUTENTICACIÓN -----------------
JWT_SECRET=tu-clave-secreta-jwt-de-al-menos-256-bits-para-produccion
JWT_ISSUER_URI=http://localhost:8081/realms/empleabilidad

# ----------------- PUERTOS DE MICROSERVICIOS -----------------
USUARIOS_SERVICE_URL=http://localhost:8081
OFERTAS_SERVICE_URL=http://localhost:8082
POSTULACIONES_SERVICE_URL=http://localhost:8083

# ----------------- APIS EXTERNAS -----------------
# Cloudinary (Almacenamiento de CVs en PDF)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Google Gemini AI (Evaluación inteligente de postulaciones)
GEMINI_API_KEY=tu_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp

# APIsPeru (Validación de DNI y RUC)
APISPERU_TOKEN=tu_apisperu_jwt_token
APISPERU_USERNAME=tu_usuario
APISPERU_PASSWORD=tu_password
APISPERU_AUTH_URL=https://facturacion.apisperu.com/api/v1/auth/login
APISPERU_DNI_URL=https://dniruc.apisperu.com/api/v1/dni
APISPERU_RUC_URL=https://dniruc.apisperu.com/api/v1/ruc


# Jooble API (Búsqueda de empleos reales)
JOOBLE_API_KEY=
